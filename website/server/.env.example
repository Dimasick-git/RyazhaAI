# OpenRouter key. Create a key at https://openrouter.ai/keys.
# The default model below uses only the OpenRouter Free router.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Optional public deployment URL for OpenRouter attribution headers.
PUBLIC_APP_URL=https://dimasick-git.github.io/RyazhaAI/
PORT=3001
